<idea-plugin>
    <id>com.decathlon.cis.networkmocks</id>
    <name>Team Network Mocks Sync</name>
    <vendor email="matthieu.papier@decathlon.com" url="https://www.decathlon.com">Decathlon</vendor>

    <description><![CDATA[
      Plugin interne pour exporter et importer les règles du Network Inspector d'Android Studio.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="NetworkMocksNotifications" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="NetworkMocksGroup" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="ExportMocksAction"
                    class="com.decathlon.cis.networkmocks.ExportMocksAction"/>

            <action id="ImportMocksAction"
                    class="com.decathlon.cis.networkmocks.ImportMocksAction"/>
        </group>
    </actions>
</idea-plugin>